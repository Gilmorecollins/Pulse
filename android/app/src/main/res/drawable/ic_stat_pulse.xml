<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon — a simple heartbeat/pulse line, matching the
  app's name. Android renders notification icons as a flat white
  silhouette regardless of color (ignores RGB, uses alpha only), so this
  is deliberately a plain stroked line rather than the full-color
  launcher icon (@mipmap/ic_launcher), which used to collapse into an
  illegible blob in the status bar. See docs/ARCHITECTURE.md's
  "Notifications" section.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2,12 L7,12 L9,5 L12,19 L14,8 L16,12 L22,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
